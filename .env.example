# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://root@localhost:26257/loci?sslmode=disable
DEMO_USER_HANDLE=arjun

# ── Chat model (any OpenAI-compatible endpoint) ───────────────────────────────
# Local default: Ollama. Run `ollama pull qwen2.5:3b`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.4

# ── Embeddings ────────────────────────────────────────────────────────────────
# 768 dimensions keeps the schema compatible with nomic-embed-text and
# OpenAI's text-embedding-3-small (passed with dimensions=768).
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional: force deterministic local embeddings (no network) — good for tests.
# EMBEDDING_PROVIDER=hash

# ── Memory tuning ─────────────────────────────────────────────────────────────
MEMORY_TOP_K=8
MEMORY_CANDIDATES=24
MEMORY_DEDUPE_THRESHOLD=0.88
AGENT_MAX_STEPS=4

# ── Using a hosted OpenAI-compatible model ────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=768
